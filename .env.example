# ── LLM Provider ──────────────────────────────────────────────────────────────
# Controls which LLM backend the chatbot uses.
# "openai" (default) → ChatGPT via OpenAI API  — requires OPENAI_API_KEY
# "ollama"           → Gemma 2 via Ollama local — requires Ollama daemon running
# Switch providers: change this value + restart the server (uvicorn main:app --reload)
# No code changes needed when switching.
LLM_PROVIDER=openai

# ── OpenAI provider (active when LLM_PROVIDER=openai) ─────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Ollama / Gemma 2 provider (active when LLM_PROVIDER=ollama) ───────────────
# Ollama must be installed and running: https://ollama.com/download
# Pull the model before first use: ollama pull gemma2:2b
#
# Model size guide:
#   gemma2:2b  — ~1.7 GB download, 8 GB RAM,  CPU only, fastest
#   gemma2:9b  — ~5.4 GB download, 16 GB RAM, better quality
#   gemma2:27b — ~16 GB download,  32 GB RAM, best quality (GPU recommended)
#
# OLLAMA_MODEL=gemma2:2b
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L12-v2

# Jira integration — optional, only needed if using jira_search / jira_create tools
# Get your API token at: https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_URL=https://kuuli.atlassian.net
# JIRA_EMAIL=jmarco@kuuli.tech
# JIRA_TOKEN=your_jira_api_token_here
# JIRA_PROJECT=MAR

# WhatsApp Business (Meta Cloud API) — optional, only needed if using /webhook
# WHATSAPP_VERIFY_TOKEN=your_verification_token   # token you define and set in Meta Developer Console
# WHATSAPP_ACCESS_TOKEN=your_access_token         # Meta app access token (temporary or permanent)
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id   # phone number ID from Meta Developer Console
